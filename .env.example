# Copy to .env and fill in. Never commit the real .env.

# Primary provider for this project. Get a key at
# https://platform.openai.com/api-keys (separate from a ChatGPT
# subscription -- this is pay-as-you-go API billing).
OPENAI_API_KEY=sk-...

# Optional -- only needed if you pass --provider anthropic. Not the
# default; supported by the same ModelProvider abstraction, see
# PROJECT_GUIDE.md.
# ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides (defaults shown)
HARNESS_MAX_COST_USD=5.00
HARNESS_MAX_WORKERS=4

# Cheapest viable option by default. Leave unset to auto-pick a sensible
# default for whichever --provider you choose (gpt-6-luna for openai,
# claude-haiku-4-5-20251001 for anthropic). Run `harness calibrate` after
# any change here and check the MAE/correlation before trusting it for
# gating -- see CALIBRATION.md.
# HARNESS_JUDGE_MODEL=gpt-6-luna
