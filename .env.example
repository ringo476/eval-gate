# Copy to .env and fill in. Never commit the real .env.
#
# You can run the whole harness with NO keys at all:
#   --provider mock    free fake model (exercises the harness, not model quality)
#   --provider ollama  a local model via Ollama (free; needs `ollama serve` + a pulled model)

# OpenAI -- needed only for --provider openai. Get a key at
# https://platform.openai.com/api-keys (separate from a ChatGPT
# subscription -- this is pay-as-you-go API billing).
OPENAI_API_KEY=sk-...

# Optional -- only needed for --provider anthropic.
# ANTHROPIC_API_KEY=sk-ant-...

# Local models (Ollama's OpenAI-compatible endpoint). Default shown.
# HARNESS_OLLAMA_URL=http://localhost:11434/v1

# Spend cap per run, in USD. Checked before every paid call.
HARNESS_MAX_COST_USD=5.00
HARNESS_MAX_WORKERS=4

# Sampling. 0 makes runs as repeatable as the model allows; raise it together
# with `run --repeats N` to measure run-to-run flakiness.
# HARNESS_TEMPERATURE=0
# Reasoning models spend output tokens thinking before they answer; raise this
# if replies come back empty or truncated.
# HARNESS_MAX_OUTPUT_TOKENS=1024

# Judge model. Leave unset to use a per-provider default (gpt-6-luna for
# openai, gpt-oss:20b for ollama). Prefer a judge DIFFERENT from the model
# under test (self-preference bias), and run `harness calibrate` after any
# change here before trusting it for gating -- see CALIBRATION.md.
# HARNESS_JUDGE_MODEL=gpt-6-luna

# Where state lives (defaults shown). baselines/ is meant to be committed.
# HARNESS_RUNS_DB=runs.db
# HARNESS_CACHE_DB=.harness_cache.db
# HARNESS_BASELINES_DIR=baselines
# HARNESS_REPORTS_DIR=reports
