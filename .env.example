# Copy to .env and fill in. Never commit the real .env.
ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides (defaults shown)
HARNESS_MAX_COST_USD=5.00
HARNESS_MAX_WORKERS=4
# Cheapest viable option by default -- run `harness calibrate` after any
# change here and check the MAE/correlation before trusting it for gating.
# Bump to claude-sonnet-5 only if calibration shows Haiku isn't good enough.
HARNESS_JUDGE_MODEL=claude-haiku-4-5-20251001
